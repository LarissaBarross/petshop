@model PetShop.Models.ReservaServico

@{
    ViewData["Title"] = "Criar serviço";
}

<h1>Criar serviço</h1>

<h4>Reserva de serviço</h4>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-controller="ReservaServico"
              asp-action="Create"
              method="post">

            <div asp-validation-summary="All"
                 class="text-danger">
            </div>

            <div class="form-group mb-3">
                <label asp-for="DataHora" class="control-label">
                    Data e hora
                </label>

                <input asp-for="DataHora"
                       type="datetime-local"
                       class="form-control" />

                <span asp-validation-for="DataHora"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Valor" class="control-label">
                    Valor
                </label>

                <input asp-for="Valor"
                       type="number"
                       step="0.01"
                       min="0"
                       class="form-control" />

                <span asp-validation-for="Valor"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StatusServico" class="control-label">
                    Status do serviço
                </label>

                <select asp-for="StatusServico"
                        class="form-control">

                    <option value="">Selecione o status</option>
                    <option value="Agendado">Agendado</option>
                    <option value="Em andamento">Em andamento</option>
                    <option value="Concluído">Concluído</option>
                    <option value="Cancelado">Cancelado</option>

                </select>

                <span asp-validation-for="StatusServico"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ClienteId" class="control-label">
                    Cliente
                </label>

                <select asp-for="ClienteId"
                        class="form-control"
                        asp-items="ViewBag.ClienteId">

                    <option value="">Selecione o cliente</option>

                </select>

                <span asp-validation-for="ClienteId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="VeterinarioId" class="control-label">
                    Veterinário
                </label>

                <select asp-for="VeterinarioId"
                        class="form-control"
                        asp-items="ViewBag.VeterinarioId">

                    <option value="">Selecione o veterinário</option>

                </select>

                <span asp-validation-for="VeterinarioId"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mt-4">
                <button type="submit"
                        class="btn btn-primary">
                    Criar serviço
                </button>

                <a asp-controller="ReservaServico"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
